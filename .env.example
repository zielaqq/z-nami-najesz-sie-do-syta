# =============================================================================
#  Z nami najesz się do syta – zmienne środowiskowe
#  Skopiuj ten plik do `.env.local` (lokalnie) albo ustaw te same zmienne
#  w panelu hostingu (np. Vercel → Project Settings → Environment Variables).
#  NIGDY nie commituj prawdziwych kluczy. Plik `.env.local` jest w .gitignore.
# =============================================================================

# --- Adres strony (wymagany na produkcji) -------------------------------------
# Używany w canonical, Open Graph, sitemap.xml, robots.txt i danych strukturalnych.
# Bez ukośnika na końcu. Na Vercel, jeśli nie podasz, użyty zostanie
# VERCEL_PROJECT_PRODUCTION_URL, lokalnie http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://twoja-domena.pl

# --- Mapa Google Maps Embed API – opcjonalne ---------------------------------
# Klucz publiczny (trafia do przeglądarki) – KONIECZNIE ogranicz go w Google
# Cloud do referrerów Twojej domeny i do API "Maps Embed API".
# Bez klucza mapa używa standardowego osadzenia iframe bez klucza.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# --- Menu na dziś i panel klientki (Supabase) – opcjonalne -------------------------
# Instrukcja: docs/PANEL-MENU.md. Klucz „publishable/anon” jest publiczny z założenia (chronią go reguły
# Row Level Security w bazie), ale i tak trzymamy go tutaj, a nie w kodzie.
# ⚠ NIGDY nie wpisuj klucza „service_role” / „secret” – jest tajny i daje pełny dostęp do bazy.
# Bez tych dwóch zmiennych strona pokazuje menu przykładowe z src/data/menu.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Podgląd na GitHub Pages – ustawia go workflow, lokalnie zwykle niepotrzebne -
# Patrz docs/GITHUB-PAGES.md.
#   STATIC_EXPORT=true          eksport statyczny do folderu out/ (GitHub Pages nie ma serwera)
#   NEXT_PUBLIC_BASE_PATH=/nazwa-repozytorium   podkatalog adresu (przy własnej domenie puste)
#   NEXT_PUBLIC_NOINDEX=true    prosi wyszukiwarki, by NIE indeksowały podglądu
# STATIC_EXPORT=
# NEXT_PUBLIC_BASE_PATH=
# NEXT_PUBLIC_NOINDEX=
